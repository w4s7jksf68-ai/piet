# Linux release builder. Build on Ubuntu 24.04 with the supported WebKitGTK and math libraries.
# docker build --platform linux/amd64 -f docker/Dockerfile.piet-linux -t piet-linux-builder .
# docker run --rm -v "$PWD:/src" -w /src piet-linux-builder sh scripts/build-linux.sh
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config python3 \
    libopenblas-dev liblapacke-dev libwebkit2gtk-4.1-dev \
    ca-certificates dpkg-dev file xz-utils xvfb xauth dbus-x11 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
